<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>CompressionSettingsDialog</class>
 <widget class="QDialog" name="CompressionSettingsDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>560</width>
    <height>280</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Compression settings</string>
  </property>
  <layout class="QVBoxLayout" name="rootLayout">
   <item>
    <widget class="QGroupBox" name="toolsBox">
     <property name="title">
      <string>Archives</string>
     </property>
     <layout class="QFormLayout" name="toolsForm">
      <item row="0" column="0">
       <widget class="QLabel" name="compressPathLbl">
        <property name="text">
         <string>Compress Path: </string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <layout class="QHBoxLayout" name="compressPathLayout">
        <item>
         <widget class="QLineEdit" name="compressPathEdit">
          <property name="toolTip">
           <string>temporary folder where the archives and par2 will be created (it will be cleaned once the post is done)</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="compressPathButton">
          <property name="maximumSize">
           <size>
            <width>30</width>
            <height>16777215</height>
           </size>
          </property>
          <property name="toolTip">
           <string>select the temporary folder where the archives and par2 will be created (it will be cleaned once the post is done)</string>
          </property>
          <property name="text">
           <string>...</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="rarLbl">
        <property name="text">
         <string>RAR Path: </string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <layout class="QHBoxLayout" name="rarPathLayout">
        <item>
         <widget class="QLineEdit" name="rarEdit">
          <property name="toolTip">
           <string>full path of the rar executable</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="rarPathButton">
          <property name="maximumSize">
           <size>
            <width>30</width>
            <height>16777215</height>
           </size>
          </property>
          <property name="toolTip">
           <string>select rar executable</string>
          </property>
          <property name="text">
           <string>...</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="rarSizeLbl">
        <property name="text">
         <string>Vol size (MB):</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <layout class="QHBoxLayout" name="rarSizeLayout">
        <item>
         <widget class="QLineEdit" name="rarSizeEdit">
          <property name="maximumSize">
           <size>
            <width>80</width>
            <height>16777215</height>
           </size>
          </property>
          <property name="toolTip">
           <string>to split the rar archive in several volumes (0 to don't split)</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="rarMaxCB">
          <property name="toolTip">
           <string>cap the number of volumes: ngPost raises the volume size rather than making more of them (config RAR_MAX)</string>
          </property>
          <property name="text">
           <string>Limit RAR Number</string>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="rarSizeSpacer">
          <property name="orientation">
           <enum>Qt::Orientation::Horizontal</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>40</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
      <item row="3" column="1">
       <widget class="QCheckBox" name="keepRarDefaultCB">
        <property name="toolTip">
         <string>Archives and par2 are deleted once the post succeeds.
Ticked, they are left in the compression path folder instead.
This is the default every new post starts with; each post can still decide otherwise (config KEEP_RAR).</string>
        </property>
        <property name="text">
         <string>Keep the archives on disk</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="passwordBox">
     <property name="title">
      <string>Archive password</string>
     </property>
     <layout class="QHBoxLayout" name="passwordLayout">
      <item>
       <widget class="QCheckBox" name="rarPassCB">
        <property name="toolTip">
         <string>use the same password for every post (config RAR_PASS)</string>
        </property>
        <property name="text">
         <string>Enable the default archive password</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLineEdit" name="rarPassEdit">
        <property name="toolTip">
         <string>password used for all the archives (it is also written in the header of the nzb file)</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QSpinBox" name="rarLengthSB">
        <property name="maximumSize">
         <size>
          <width>60</width>
          <height>16777215</height>
         </size>
        </property>
        <property name="toolTip">
         <string>length of the password drawn by the dice button (config LENGTH_PASS)</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="genPass">
        <property name="maximumSize">
         <size>
          <width>24</width>
          <height>24</height>
         </size>
        </property>
        <property name="toolTip">
         <string>generate random password</string>
        </property>
        <property name="text">
         <string/>
        </property>
        <property name="icon">
         <iconset resource="../resources/resources.qrc">
          <normaloff>:/icons/genKey.png</normaloff>:/icons/genKey.png</iconset>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Orientation::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>10</height>
      </size>
     </property>
    </spacer>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Save</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources>
  <include location="../resources/resources.qrc"/>
