# .clang-format -- the style the code base already follows, written down.
#
# Calibrated on the recently written sources with clang-format 18: close to
# nine lines in ten come out unchanged. The tree is deliberately NOT
# reformatted in bulk (that would bury `git blame`); CI checks only the lines a
# change touches, see .github/scripts/check-format.sh.
#
# To format your own changes before committing:
#
#   git add -p && git clang-format        # staged changes
#   git clang-format origin/master        # everything since master
#
# Use clang-format 18 (`pip install clang-format==18.1.8`): other major
# versions break some constructs differently, and CI would disagree.
---
Language: Cpp
BasedOnStyle: WebKit
Standard: c++17
ColumnLimit: 100

# Braces on their own line for types, functions and namespaces only.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: true
  AfterControlStatement: Never
  AfterEnum: false
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true

AccessModifierOffset: -4
EmptyLineBeforeAccessModifier: LogicalBlock
NamespaceIndentation: None
FixNamespaceComments: false
IndentCaseLabels: false
LambdaBodyIndentation: OuterScope

BreakConstructorInitializers: BeforeComma
PackConstructorInitializers: BinPack
BreakBeforeBinaryOperators: NonAssignment
AlignOperands: DontAlign
AlignAfterOpenBracket: Align
BinPackArguments: false
BinPackParameters: false
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
AlwaysBreakTemplateDeclarations: Yes
SpaceAfterTemplateKeyword: true

AllowShortFunctionsOnASingleLine: InlineOnly
AllowShortIfStatementsOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: true
AllowShortLambdasOnASingleLine: All
AllowShortEnumsOnASingleLine: false

PointerAlignment: Right
ReferenceAlignment: Pointer
Cpp11BracedListStyle: false
SpaceBeforeCpp11BracedList: false

AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignTrailingComments: true
SpacesBeforeTrailingComments: 1
ReflowComments: false
BreakStringLiterals: true

# Include order is meaningful in places (platform headers); leave it alone.
SortIncludes: Never
IncludeBlocks: Preserve

MaxEmptyLinesToKeep: 2
KeepEmptyLinesAtTheStartOfBlocks: true

PenaltyBreakAssignment: 200
PenaltyBreakBeforeFirstCallParameter: 100
PenaltyReturnTypeOnItsOwnLine: 200
