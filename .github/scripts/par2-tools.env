# Pinned PAR2 tool versions and asset checksums.
#
# One list for every workflow: the release packages and the test jobs that vet
# them cannot end up on different builds of the same tool, and a bug report only
# ever names one version per tool. Sourced by fetch-par2-tools.sh (Linux and
# macOS) and read into the environment by the Windows release job.
#
# Every download is verified against these checksums: the upstream tag alone
# would let a re-tagged or replaced asset through, and these binaries run on the
# user's machine over the files they are about to post.
#
# ParPar on Linux must stay the "partly-static" (glibc) build: the fully static
# one cannot dlopen the OpenCL loader, which silently costs GPU acceleration.
PARPAR_VERSION=0.4.6
PARPAR_SHA256_WIN64=9a7d9f50b8a519e0a49263d80b62ce9c4312eecf6723311211824b5facf73c6d
PARPAR_SHA256_LINUX_AMD64=88c8cff9f291fa50e20522a69ca9047baf11577968fc210f4c96cfa41695c026
PARPAR_SHA256_MACOS_ARM64=64719940ed45de63b70740d12854656c3d047d61c7749e42055489aa955a0afd
PARPAR_SHA256_MACOS_X64=8104b60ed2f9decd88a6157aec0885892fe7af008dbb4ff08596e388c584bfb0
PAR2CMDLINE_VERSION=1.4.0
PAR2CMDLINE_SHA256_WIN_X64=200130143dba1e12f9d1be567d5a446e785d2093e5d735225d8ad0539125b71c
PAR2CMDLINE_SHA256_LINUX_AMD64=6360228699d66b0141e2583b4f4b17260344c28f599bfe2e28db596b26703105
PAR2CMDLINE_SHA256_MACOS_UNIVERSAL=e87d0d0c758f4e1df6c06690e351e54d7a9eab3697f496fd03d41552bcc322ee
MULTIPAR_VERSION=1.3.3.6
